{
  "name": "dopamine-train",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ダンベルのレップをこなさないとショート動画が見られないシステム",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tensorflow-models/pose-detection": "2.1.3",
    "@tensorflow/tfjs-backend-webgl": "4.22.0",
    "@tensorflow/tfjs-converter": "4.22.0",
    "@tensorflow/tfjs-core": "4.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "overrides": {
    "@tensorflow-models/pose-detection": {
      "@tensorflow/tfjs-backend-webgl": "4.22.0",
      "@tensorflow/tfjs-converter": "4.22.0",
      "@tensorflow/tfjs-core": "4.22.0"
    }
  }
}
