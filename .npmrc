# @tensorflow-models/pose-detection の peer 依存は optional 指定されていないため、
# npm 7+ が全部を自動インストールしようとする（未使用の @mediapipe/pose 50MB、
# tfjs-backend-wasm 12.6MB、tfjs-backend-webgpu 16.8MB を含めて約160MB）。
# 必要な4つだけを dependencies に明示するため、自動 peer 解決を切る。
legacy-peer-deps=true

# 上流（pose-detection 2.1.3 / tfjs 4.22.0）は凍結済みなのでバージョンは完全固定する。
# `npm i <pkg>` が勝手に ^ を付けないようにする。
save-exact=true
